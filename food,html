// Cuisino - Single-file React app (App.jsx)
// Features: menu grid, add multiple items to cart, combined delivery, low-price filtering, deals, responsive UI
// Tech: React + TailwindCSS + framer-motion + lucide-react icons
// How to run: create-react-app, install tailwind, framer-motion, lucide-react. Replace src/App.jsx with this file.

import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { ShoppingCart, Truck, Tag, Search, X, Plus, Minus } from 'lucide-react';

const SAMPLE_MENU = [
  { id: 'b1', name: 'Margherita Pizza', desc: 'Classic cheese & basil', price: 199, category: 'Pizza', img: 'https://images.unsplash.com/photo-1601924638867-3ec4b1f76a13?w=800&q=60' },
  { id: 'b2', name: 'Paneer Tikka Wrap', desc: 'Smoky paneer, soft wrap', price: 129, category: 'Wraps', img: 'https://images.unsplash.com/photo-1604908177522-4b6a5adb7f2a?w=800&q=60' },
  { id: 'b3', name: 'Veg Biryani', desc: 'Fragrant basmati with veggies', price: 159, category: 'Rice', img: 'https://images.unsplash.com/photo-1604908177521-1bb0ce145a3b?w=800&q=60' },
  { id: 'b4', name: 'Choco Lava Cake', desc: 'Molten chocolate center', price: 89, category: 'Dessert', img: 'https://images.unsplash.com/photo-1542827638-32d9f1e0d4a3?w=800&q=60' },
  { id: 'b5', name: 'Masala Dosa', desc: 'Crispy dosa with potato masala', price: 99, category: 'South Indian', img: 'https://images.unsplash.com/photo-1600891964599-f61ba0e24092?w=800&q=60' },
  { id: 'b6', name: 'Veg Burger', desc: 'Juicy patty, soft bun', price: 119, category: 'Burgers', img: 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800&q=60' },
];

function formatINR(n){
  return '₹' + n.toString();
}

export default function CuisinoApp(){
  const [menu, setMenu] = useState(SAMPLE_MENU);
  const [query, setQuery] = useState('');
  const [minPrice, setMinPrice] = useState(0);
  const [maxPrice, setMaxPrice] = useState(1000);
  const [cart, setCart] = useState(() => {
    try{ return JSON.parse(localStorage.getItem('cuisino_cart')) || {}; }catch{ return {}; }
  });
  const [showCart, setShowCart] = useState(false);
  const [highlightDeals, setHighlightDeals] = useState(true);

  useEffect(()=>{
    localStorage.setItem('cuisino_cart', JSON.stringify(cart));
  },[cart]);

  // Derived
  const cartItems = Object.values(cart);
  const subtotal = cartItems.reduce((s,i)=> s + i.price * i.qty, 0);

  // Simple delivery charge logic: free delivery for subtotal >= 300, else 40.
  const deliveryFee = subtotal >= 300 || subtotal === 0 ? 0 : 40;
  // Low-price promo: if subtotal < 200 offer 'Combo Saver' suggestions

  function addToCart(item){
    setCart(prev=>{
      const next = { ...prev };
      if(next[item.id]) next[item.id].qty += 1;
      else next[item.id] = { ...item, qty: 1 };
      return next;
    });
  }

  function updateQty(id, newQty){
    setCart(prev => {
      const next = { ...prev };
      if(!next[id]) return prev;
      if(newQty <= 0) delete next[id];
      else next[id].qty = newQty;
      return next;
    });
  }

  function clearCart(){ setCart({}); }

  const filtered = menu.filter(m => {
    const matchesQuery = (m.name + ' ' + m.desc + ' ' + m.category).toLowerCase().includes(query.toLowerCase());
    const inRange = m.price >= minPrice && m.price <= maxPrice;
    return matchesQuery && inRange;
  });

  // Deal score: lower price & popular categories get boosted
  function dealScore(item){
    let score = 100 - item.price;
    if(['Pizza','Burgers'].includes(item.category)) score += 10;
    if(item.price <= 100) score += 10;
    return score;
  }

  const deals = [...menu].sort((a,b)=> dealScore(b) - dealScore(a)).slice(0,3);

  return (
    <div className="min-h-screen bg-gradient-to-b from-rose-50 to-white p-6 lg:p-12">
      <header className="max-w-6xl mx-auto flex items-center justify-between">
        <div className="flex items-center gap-4">
          <div className="bg-gradient-to-br from-red-500 to-rose-600 text-white px-4 py-2 rounded-2xl font-bold text-xl">Cuisino</div>
          <div className="text-sm text-slate-600">Delivering multiple items at once • Low-price deals</div>
        </div>

        <div className="flex items-center gap-3">
          <div className="hidden md:flex items-center gap-2 bg-white p-2 rounded-full shadow-sm">
            <Search size={16} />
            <input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search dishes, categories..." className="outline-none text-sm w-48" />
          </div>

          <button onClick={()=>setShowCart(s=>!s)} className="relative bg-white p-2 rounded-full shadow hover:scale-105 transition">
            <ShoppingCart size={18} />
            {cartItems.length > 0 && <span className="absolute -top-1 -right-1 bg-rose-600 text-white text-xs rounded-full px-1">{cartItems.length}</span>}
          </button>
        </div>
      </header>

      <main className="max-w-6xl mx-auto mt-8 grid grid-cols-1 lg:grid-cols-4 gap-6">
        {/* Left - Filters & Deals */}
        <aside className="col-span-1 bg-white p-4 rounded-2xl shadow">
          <h3 className="font-semibold">Filters</h3>
          <div className="mt-3 flex flex-col gap-2">
            <label className="text-xs text-slate-500">Price range</label>
            <div className="flex items-center gap-2">
              <input type="number" value={minPrice} onChange={e=>setMinPrice(Number(e.target.value))} className="w-20 p-2 border rounded" />
              <span className="text-slate-400">to</span>
              <input type="number" value={maxPrice} onChange={e=>setMaxPrice(Number(e.target.value))} className="w-20 p-2 border rounded" />
            </div>

            <label className="flex items-center gap-2 mt-2">
              <input type="checkbox" checked={highlightDeals} onChange={e=>setHighlightDeals(e.target.checked)} />
              <span className="text-sm">Highlight Budget Deals</span>
            </label>
          </div>

          <div className="mt-6">
            <h4 className="font-semibold mb-2 flex items-center gap-2">Top Deals <Tag size={14} /></h4>
            <div className="flex flex-col gap-3">
              {deals.map(d => (
                <div key={d.id} className="flex items-center gap-3">
                  <img src={d.img} alt="" className="w-16 h-12 rounded-lg object-cover" />
                  <div className="flex-1">
                    <div className="text-sm font-medium">{d.name}</div>
                    <div className="text-xs text-slate-400">{formatINR(d.price)}</div>
                  </div>
                  <button onClick={()=>addToCart(d)} className="text-xs bg-rose-500 text-white px-3 py-1 rounded">ADD</button>
                </div>
              ))}
            </div>
          </div>

          <div className="mt-6 text-xs text-slate-500">
            Low price + combined delivery = savings. Orders above {formatINR(300)} get <strong>free delivery</strong>.
          </div>
        </aside>

        {/* Middle - Menu */}
        <section className="lg:col-span-2 bg-white p-4 rounded-2xl shadow">
          <div className="flex items-center justify-between">
            <h2 className="text-xl font-semibold">Menu</h2>
            <div className="text-sm text-slate-500">Showing {filtered.length} items</div>
          </div>

          <div className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {filtered.map(item => (
              <motion.article key={item.id} layout whileHover={{ y: -4 }} className={`flex gap-4 p-3 rounded-xl border ${highlightDeals && item.price <= 120 ? 'ring-2 ring-rose-100' : 'bg-white'}`}>
                <img src={item.img} alt="" className="w-28 h-20 rounded-lg object-cover" />
                <div className="flex-1">
                  <div className="flex items-start justify-between">
                    <div>
                      <div className="font-medium">{item.name}</div>
                      <div className="text-xs text-slate-400">{item.desc}</div>
                    </div>
                    <div className="text-sm font-semibold">{formatINR(item.price)}</div>
                  </div>

                  <div className="mt-3 flex items-center gap-2">
                    <button onClick={()=>addToCart(item)} className="text-xs bg-rose-500 text-white px-3 py-1 rounded">Add</button>
                    <button onClick={()=>{
                      // quick add 2 for shared orders
                      addToCart(item); addToCart(item);
                    }} className="text-xs border px-2 py-1 rounded">Add x2</button>
                    <div className="ml-auto text-xs text-slate-400">Category: {item.category}</div>
                  </div>
                </div>
              </motion.article>
            ))}
            {filtered.length === 0 && <div className="col-span-full text-center text-slate-500 py-8">No items match your filters.</div>}
          </div>
        </section>

        {/* Right - Cart & Checkout */}
        <aside className="col-span-1 bg-white p-4 rounded-2xl shadow sticky top-6 h-fit">
          <div className="flex items-center justify-between">
            <h3 className="font-semibold flex items-center gap-2"><Truck size={16} /> Your Order</h3>
            <button className="text-xs text-slate-500" onClick={clearCart}>Clear</button>
          </div>

          <div className="mt-3">
            <AnimatePresence>
              {cartItems.length === 0 && (
                <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="text-sm text-slate-400">Cart is empty. Add items from the menu.</motion.div>
              )}

              {cartItems.map(ci => (
                <motion.div key={ci.id} initial={{ opacity: 0, y: 6 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -6 }} className="flex items-center gap-3 mt-3">
                  <img src={ci.img} alt="" className="w-12 h-10 rounded object-cover" />
                  <div className="flex-1">
                    <div className="text-sm font-medium">{ci.name}</div>
                    <div className="text-xs text-slate-400">{formatINR(ci.price)} x {ci.qty} = {formatINR(ci.price * ci.qty)}</div>
                  </div>
                  <div className="flex items-center gap-1">
                    <button onClick={()=>updateQty(ci.id, ci.qty - 1)} className="p-1 border rounded"><Minus size={12} /></button>
                    <div className="px-2 text-sm">{ci.qty}</div>
                    <button onClick={()=>updateQty(ci.id, ci.qty + 1)} className="p-1 border rounded"><Plus size={12} /></button>
                  </div>
                </motion.div>
              ))}
            </AnimatePresence>
          </div>

          <div className="mt-4 border-t pt-4">
            <div className="flex justify-between text-sm text-slate-600"><span>Subtotal</span><span>{formatINR(subtotal)}</span></div>
            <div className="flex justify-between text-sm text-slate-600"><span>Delivery</span><span>{deliveryFee === 0 ? 'Free' : formatINR(deliveryFee)}</span></div>
            <div className="flex justify-between font-semibold mt-2"><span>Total</span><span>{formatINR(subtotal + deliveryFee)}</span></div>

            <button disabled={subtotal === 0} onClick={()=>{
              // Checkout flow - For demo we just 'place order' and clear cart
              alert('Order placed! Your items will be delivered together.');
              clearCart();
            }} className={`w-full mt-4 py-2 rounded-xl ${subtotal===0 ? 'bg-slate-300' : 'bg-rose-600 text-white'}`}>
              {subtotal===0 ? 'Add items to checkout' : 'Place Order'}
            </button>

            {/* Suggestion for low-price customers */}
            {subtotal > 0 && subtotal < 200 && (
              <div className="mt-3 text-xs bg-rose-50 p-2 rounded text-slate-600">
                Tip: Add one more item to reach {formatINR(200)} and unlock a combo saver or free delivery at {formatINR(300)}.
              </div>
            )}
          </div>

          <div className="mt-4 text-xs text-slate-400">This is a demo frontend. Integrate payment and delivery APIs to make it production-ready.</div>
        </aside>
      </main>

      {/* Floating quick-cart for mobile */}
      <AnimatePresence>
        {cartItems.length > 0 && (
          <motion.button initial={{ y: 80 }} animate={{ y: 0 }} exit={{ y: 80 }} className="fixed bottom-6 left-1/2 transform -translate-x-1/2 md:hidden bg-rose-600 text-white px-5 py-3 rounded-full shadow-lg flex items-center gap-3" onClick={()=>setShowCart(true)}>
            <ShoppingCart size={18} /> View Cart • {formatINR(subtotal + deliveryFee)}
          </motion.button>
        )}
      </AnimatePresence>

      {/* Small cart drawer */}
      <AnimatePresence>
        {showCart && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="fixed inset-0 bg-black/40 flex items-end md:items-center justify-center p-4">
            <motion.div initial={{ y: 200 }} animate={{ y: 0 }} exit={{ y: 200 }} className="w-full md:w-3/4 lg:w-1/2 bg-white rounded-2xl p-6">
              <div className="flex items-center justify-between">
                <h4 className="font-semibold">Your Cart</h4>
                <button onClick={()=>setShowCart(false)} className="p-2 rounded-full"><X size={18} /></button>
              </div>

              <div className="mt-4 max-h-72 overflow-auto">
                {cartItems.map(ci => (
                  <div key={ci.id} className="flex items-center gap-3 mb-3">
                    <img src={ci.img} className="w-14 h-12 rounded object-cover" />
                    <div className="flex-1">
                      <div className="font-medium">{ci.name}</div>
                      <div className="text-xs text-slate-500">{ci.qty} × {formatINR(ci.price)}</div>
                    </div>
                    <div className="flex items-center gap-2">
                      <button onClick={()=>updateQty(ci.id, ci.qty - 1)} className="p-1 border rounded"><Minus size={12} /></button>
                      <div className="px-2">{ci.qty}</div>
                      <button onClick={()=>updateQty(ci.id, ci.qty + 1)} className="p-1 border rounded"><Plus size={12} /></button>
                    </div>
                  </div>
                ))}
              </div>

              <div className="mt-4 flex justify-between">
                <div>
                  <div className="text-sm text-slate-600">Total</div>
                  <div className="font-semibold text-lg">{formatINR(subtotal + deliveryFee)}</div>
                </div>
                <div className="flex flex-col gap-2">
                  <button onClick={()=>{ alert('Order placed!'); clearCart(); setShowCart(false); }} className="bg-rose-600 text-white px-4 py-2 rounded">Place Order</button>
                  <button onClick={() => { setShowCart(false); }} className="px-4 py-2 rounded border">Close</button>
                </div>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
